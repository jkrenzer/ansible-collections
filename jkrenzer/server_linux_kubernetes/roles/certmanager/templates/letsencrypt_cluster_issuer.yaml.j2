apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
 name: letsencrypt-cluster-issuer
spec:
 acme:
   email: {{ certmanager_config.acme.email }}
   server: {{ certmanager_config.acme.server or 'https://acme-staging-v02.api.letsencrypt.org/directory' }}
   privateKeySecretRef:
     name: letsencrypt-cluster-issuer-private-key
   solvers:
     - http01:
         # The ingressClass used to create the necessary ingress routes
         ingress:
           class: {{ certmanager_config.acme.ingress_class or 'traefik' }}